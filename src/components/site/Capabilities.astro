---
import { type Lang } from '../../i18n';
import { useSite } from '../../i18n/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useSite(lang).capabilities;
---

<section aria-labelledby="capabilities-title" id="capabilities" class="container-x pt-[var(--section-space)]">
  <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4 border-t border-line pt-10 lg:pt-14">
    <h2 id="capabilities-title" class="statement statement-sm">{c.heading}<span class="period">.</span></h2>
    <p class="max-w-[42ch] text-ink-2">{c.intro}</p>
  </div>

  <ul class="caps mt-10 lg:mt-14">
    {c.items.map((item) => (
      <li class="cap">
        <h3 class="cap-title">{item.title}</h3>
        <p class="mt-3 max-w-[44ch] text-ink-2">{item.body}</p>
        <p class="label mt-5">
          <span class="text-muted">{c.evidenceLabel} — </span><span class="text-ink">{item.evidence.join(' · ')}</span>
        </p>
      </li>
    ))}
  </ul>
</section>

<style>
  .caps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--color-line);
  }
  .cap {
    padding-block: 1.75rem 2rem;
    border-bottom: 1px solid var(--color-line);
  }
  .cap-title {
    font-size: clamp(1.5rem, 1.15rem + 1.2vw, 2.25rem);
    font-weight: 560;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .caps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cap:nth-child(odd) {
      padding-right: clamp(1.5rem, 1rem + 3vw, 4rem);
      border-right: 1px solid var(--color-line);
    }
    .cap:nth-child(even) {
      padding-left: clamp(1.5rem, 1rem + 3vw, 4rem);
    }
    .cap {
      padding-block: 2.25rem 2.5rem;
    }
  }
</style>
