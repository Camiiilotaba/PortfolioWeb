---
// DOM order (heading → email → links) is the reading order; on desktop the grid lifts the links beside the heading.
import { CV_PATHS, PERSON } from '../../data/profile';
import { useDict, type Lang } from '../../i18n';
import Arrow from '../Arrow.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useDict(lang);
const c = t.contact;
const [user, domain] = PERSON.email.split('@');
---

<section aria-labelledby="contact-title" id="contact" class="contact container-x">
  <div class="grid-12 gap-y-12 border-t border-line pt-10 lg:pt-14">
    <div class="lg:col-span-7 lg:row-start-1">
      <p class="label">{t.nav.contact}</p>
      <h2 id="contact-title" class="statement mt-4">
        <span>{c.heading}<span class="period">.</span></span>
      </h2>
      <p class="text-lead mt-6 max-w-[38ch] text-ink-2">{c.subtitle}</p>

    </div>

    <div class="flex flex-col items-start gap-3 lg:col-span-12 lg:row-start-2 xl:flex-row xl:items-end xl:justify-between">
      <a href={`mailto:${PERSON.email}`} class="email link">{user}<wbr />@{domain}</a>
      <button type="button" class="btn btn-secondary min-h-11 px-4 text-[0.9375rem]" data-copy={PERSON.email} hidden>
        <span data-copy-label aria-hidden="true">{c.copy}</span>
        <span class="sr-only">{c.copyLabel}</span>
      </button>
      <p class="label sr-only" aria-live="polite" data-copy-status data-done={c.copied} data-failed={c.copyFailed}></p>
    </div>

    <div class="lg:col-span-4 lg:col-start-9 lg:row-start-1 lg:self-end">
      <ul>
        <li class="index-row">
          <span class="label">LinkedIn</span>
          <a href={PERSON.linkedin} target="_blank" rel="noopener noreferrer" class="link inline-flex min-h-11 items-center gap-1.5">in/camilotaba<Arrow dir="ne" /><span class="sr-only"> {useDict(lang).newTab}</span></a>
        </li>
        <li class="index-row">
          <span class="label">GitHub</span>
          <a href={PERSON.github} target="_blank" rel="noopener noreferrer" class="link inline-flex min-h-11 items-center gap-1.5">Camiiilotaba<Arrow dir="ne" /><span class="sr-only"> {useDict(lang).newTab}</span></a>
        </li>
        <li class="index-row">
          <span class="label">CV <span class="sr-only">(PDF)</span></span>
          <span class="flex gap-4">
            <a href={CV_PATHS.es} target="_blank" rel="noopener noreferrer" hreflang="es" type="application/pdf" class="link inline-flex min-h-11 items-center">{lang === 'es' ? 'Español' : 'Spanish'}<span class="sr-only"> {useDict(lang).newTab}</span></a>
            <a href={CV_PATHS.en} target="_blank" rel="noopener noreferrer" hreflang="en" type="application/pdf" class="link inline-flex min-h-11 items-center">{lang === 'es' ? 'Inglés' : 'English'}<span class="sr-only"> {useDict(lang).newTab}</span></a>
          </span>
        </li>
        <li class="index-row">
          <span class="label">{t.hero.spec.base}</span>
          <span class="inline-flex min-h-11 items-center text-[0.9375rem]">{t.hero.spec.baseValue}</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-top: var(--section-space);
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .email {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    min-height: 2.75rem;
    font-size: clamp(1.5rem, 0.4rem + 5.6vw, 5.5rem);
    font-weight: 540;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    overflow-wrap: anywhere;
  }
  /* The pointer draws a 2 px underline over the resting 1 px rule (no colour-only change). */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .email {
      text-decoration-color: transparent;
      background-image: linear-gradient(var(--color-line-strong), var(--color-line-strong)),
        linear-gradient(currentColor, currentColor);
      background-repeat: no-repeat;
      background-position: 0 100%, 0 100%;
      background-size: 100% 1px, 0 2px;
      transition: background-size var(--dur-surface) var(--ease-out);
    }
    .email:hover,
    .email:focus-visible {
      background-size: 100% 1px, 100% 2px;
    }
  }
</style>

<script>
  import '../../scripts/copy-email';
</script>
