---
import { getImage, Picture } from 'astro:assets';
import { TRUEKAPP } from '../../data/projects';
import { useDict, type Lang } from '../../i18n';
import { useSite } from '../../i18n/site';
import Arrow from '../Arrow.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useDict(lang);
const site = useSite(lang).projects;
const tk = site.truekapp;
const p = t.projects.truekapp;
const L = t.projects.labels;
const img = TRUEKAPP.images[lang];
const catalog = { image: img.catalog, ...tk.shots.catalog };
const trades = { image: img.trades, ...tk.shots.trades };
// Art direction: a real phone capture below 768 px. Astro's <Picture> cannot switch sources by media query.
const DESKTOP_SIZES = '(min-width: 1024px) 50vw, 100vw';
const desktopShot = {
  avif: await getImage({ src: img.trades, format: 'avif', widths: [480, 760, 1265] }),
  webp: await getImage({ src: img.trades, format: 'webp', widths: [480, 760, 1265] }),
  jpg: await getImage({ src: img.trades, format: 'jpg', widths: [480, 760, 1265] }),
};
const phoneShot = {
  avif: await getImage({ src: img.tradesMobile, format: 'avif', widths: [390, 780, 1170] }),
  webp: await getImage({ src: img.tradesMobile, format: 'webp', widths: [390, 780, 1170] }),
  jpg: await getImage({ src: img.tradesMobile, format: 'jpg', widths: [390, 780, 1170] }),
};
---

<article aria-labelledby="tk-title" class="project">
  <div class="grid-12 items-center gap-y-8">
    <div class="lg:order-2 lg:col-span-5 lg:pl-6">
      <p class="label" aria-hidden="true">P/01 — {site.ownProject}</p>
      <h3 id="tk-title" class="title">Truekapp</h3>
      <p class="text-lead mt-4 text-ink-2">{p.summary}</p>

      <h4 class="label mt-7">{L.decisions}</h4>
      <ol class="mt-2">
        {p.decisions.map((d, i) => (
          <li class="index-row justify-start! gap-x-4">
            <span class="label" aria-hidden="true">0{i + 1}</span>
            <span class="flex-1 basis-[30ch]">{d.title}</span>
          </li>
        ))}
      </ol>

      <div class="mt-7 flex flex-wrap gap-3">
        <a href={TRUEKAPP.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary justify-between">
          <span>{p.demoLabel}</span>
          <span class="inline-flex items-center gap-2 font-mono text-[0.875rem] font-normal opacity-70 sm:text-[0.8125rem]">{TRUEKAPP.label}<Arrow dir="ne" /></span>
        <span class="sr-only"> {useDict(lang).newTab}</span></a>
        <a href={TRUEKAPP.casePath[lang]} class="btn btn-secondary">{site.caseLink}<Arrow dir="e" /></a>
      </div>
      <p class="mt-3 flex items-start gap-2.5 text-[0.9375rem] leading-snug text-ink-2">
        <span class="live-dot mt-[0.45em]" aria-hidden="true"></span>{p.status}
      </p>

      <p class="label mt-7"><span class="sr-only">{L.stack}: </span>{TRUEKAPP.stack.join(' / ')}</p>
      <p class="label mt-1">{p.codeNote}</p>
    </div>

    <figure class="lg:order-1 lg:col-span-7">
      <div class="stage">
        <div class="shot shot-main">
          <picture>
            <source media="(min-width: 768px)" type="image/avif" srcset={desktopShot.avif.srcSet.attribute} sizes={DESKTOP_SIZES} />
            <source media="(min-width: 768px)" type="image/webp" srcset={desktopShot.webp.srcSet.attribute} sizes={DESKTOP_SIZES} />
            <source media="(min-width: 768px)" srcset={desktopShot.jpg.srcSet.attribute} sizes={DESKTOP_SIZES} />
            <source type="image/avif" srcset={phoneShot.avif.srcSet.attribute} sizes="100vw" />
            <source type="image/webp" srcset={phoneShot.webp.srcSet.attribute} sizes="100vw" />
            <img
              src={phoneShot.jpg.src}
              srcset={phoneShot.jpg.srcSet.attribute}
              sizes="100vw"
              width={phoneShot.jpg.attributes.width}
              height={phoneShot.jpg.attributes.height}
              alt={trades.alt}
              loading="lazy"
              decoding="async"
              class="shot-img"
            />
          </picture>
        </div>
        <div class="shot shot-detail hidden md:block">
          <Picture src={catalog.image} alt={catalog.alt} formats={['avif', 'webp']} widths={[400, 640]} sizes="20vw" class="shot-img object-top" />
        </div>
      </div>
      <figcaption class="label mt-3">{trades.caption}<span class="hidden md:inline"> {catalog.caption}</span></figcaption>
    </figure>
  </div>
</article>

<style>
  .title {
    margin-top: 0.5rem;
    font-size: clamp(2.75rem, 1.6rem + 4vw, 5rem);
    overflow-wrap: anywhere;
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background:
      radial-gradient(120% 80% at 30% 0%, rgb(244 244 242 / 0.09), transparent 60%),
      var(--color-surface);
  }
  .shot {
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.75), 0 0 0 1px rgb(0 0 0 / 0.4);
    transition: transform var(--dur-surface) var(--ease-out);
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stage {
    padding: 7% 6% 9%;
  }
  .shot-main {
    position: relative;
    aspect-ratio: 1265 / 712;
  }
  .shot-detail {
    position: absolute;
    right: 3.5%;
    bottom: 3.5%;
    width: 30%;
    aspect-ratio: 4 / 5;
  }
  @media (max-width: 767.98px) {
    .stage {
      aspect-ratio: auto;
      padding: 5%;
    }
    .shot-main {
      aspect-ratio: 1170 / 1330;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project:hover .shot-detail {
      transform: translate(6px, 6px);
    }
  }
</style>
